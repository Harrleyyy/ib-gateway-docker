# Kopieren nach ".env" und mit den echten Paper-Trading-Zugangsdaten
# füllen, sobald IBKR den Paper-Account freigeschaltet hat.
# .env NIEMALS committen (steht in .gitignore).

# Login-Daten des SEPARATEN Paper-Trading-Kontos (nicht deine Live-Zugangsdaten!)
# Zu finden in der IBKR Account Management unter "Paper Trading Account".
IBEAM_ACCOUNT=
IBEAM_PASSWORD=

# 2FA: Nur nötig/möglich, wenn im IBKR-Konto ein TOTP-Authenticator
# (nicht IBKR-Mobile-Push) als Zwei-Faktor-Methode aktiviert ist.
# Leer lassen, falls nur Push-2FA verfügbar ist (dann ist gelegentliches
# manuelles Bestätigen auf dem Handy nötig, siehe docs/SETUP.md).
IBEAM_TWO_FA_HANDLER=
IBEAM_PYOTP_SECRET=
